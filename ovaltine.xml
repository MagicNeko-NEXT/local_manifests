<?xml version="1.0" encoding="UTF-8"?>
<!-- OnePlus 10T (ovaltine) on PixelOS seventeen. Local manifest, not a complete one. -->
<manifest>
  <remote name="pixelos-ovaltine" fetch="https://github.com/pixelos-ovaltine" revision="refs/heads/seventeen" />

  <!-- Device -->
  <project path="device/oneplus/ovaltine" name="android_device_oneplus_ovaltine" remote="pixelos-ovaltine" />
  <project path="device/oneplus/sm8450-common" name="android_device_oneplus_sm8450-common" remote="pixelos-ovaltine" />

  <!-- Vendor -->
  <project path="vendor/oneplus/ovaltine" name="proprietary_vendor_oneplus_ovaltine" remote="pixelos-ovaltine" />
  <project path="vendor/oneplus/sm8450-common" name="proprietary_vendor_oneplus_sm8450-common" remote="pixelos-ovaltine" />
  <project path="vendor/extra" name="android_vendor_extra" remote="pixelos-ovaltine" />

  <!-- Hardware -->
  <project path="hardware/oplus" name="android_hardware_oplus" remote="pixelos-ovaltine" />

  <!-- UDFPS HBM: UdfpsExtension and SDM extension hooks -->
  <remove-project name="LineageOS/android_hardware_qcom_display" path="hardware/qcom-caf/sm8450/display" />
  <project path="hardware/qcom-caf/sm8450/display" name="android_hardware_qcom_display" remote="pixelos-ovaltine" />

  <!-- livedisplay: degrade instead of aborting when the SDM backend fails -->
  <remove-project name="LineageOS/android_hardware_lineage_interfaces" path="hardware/lineage/interfaces" />
  <project path="hardware/lineage/interfaces" name="android_hardware_lineage_interfaces" remote="pixelos-ovaltine" />

  <!-- Kernel -->
  <project path="kernel/oneplus/sm8450" name="android_kernel_oneplus_sm8450" remote="pixelos-ovaltine" />
  <project path="kernel/oneplus/sm8450-devicetrees" name="android_kernel_oneplus_sm8450-devicetrees" remote="pixelos-ovaltine" />
  <project path="kernel/oneplus/sm8450-modules" name="android_kernel_oneplus_sm8450-modules" remote="pixelos-ovaltine" />
  <!-- Word order differs from the other kernel repos -->
  <project path="kernel/oneplus/gki-modules" name="android_oneplus_kernel_gki-modules" remote="pixelos-ovaltine" />
</manifest>
